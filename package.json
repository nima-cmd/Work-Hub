{
  "name": "work-hub",
  "version": "0.1.0",
  "type": "module",
  "description": "Warehouse order pipeline tracker — aggregates NetSuite saved-search exports (and later Orderful EDI + Airtable) into one aging-aware view so nothing sits ignored.",
  "author": "Nima Erfani",
  "scripts": {
    "test": "node --test",
    "analyze": "node scripts/analyze.js",
    "migrate": "node --env-file=.env.local scripts/migrate.js",
    "migrate:drive": "node --env-file=.env.local scripts/migrate-drive-folders.js",
    "ingest": "node --env-file=.env.local scripts/ingest.js",
    "match:review": "node --env-file=.env.local scripts/match-review.js",
    "sync:netsuite": "node --env-file=.env.local scripts/sync-netsuite.js",
    "sync:packages": "node --env-file=.env.local scripts/sync-edi-packages.js",
    "sync:ups-costs": "node --env-file=.env.local scripts/sync-ups-costs.js",
    "backfill:events": "node --env-file=.env.local scripts/backfill-events.js",
    "ups:rate": "node --env-file=.env.local scripts/ups-rate.js",
    "check:netsuite": "node --env-file=.env.local scripts/check-netsuite.js",
    "check:shipstation": "node --env-file=.env.local scripts/check-shipstation.js",
    "check:asn-cartons": "node --env-file=.env.local scripts/check-asn-cartons.js",
    "zpl": "node scripts/zpl-print.js",
    "zpl:watch": "node scripts/zpl-print.js --watch",
    "server": "node --env-file=.env.local server/index.js",
    "start": "node server/index.js",
    "recurring-check": "node scripts/recurring-check.js",
    "client:build": "npm --prefix client install && npm --prefix client run build",
    "dev": "concurrently \"npm --prefix client run dev\" \"npm run server\"",
    "print-agent": "node --env-file=.env.local scripts/print-agent.js",
    "backfill:fulfillment-dc": "node --env-file=.env.local scripts/backfill-fulfillment-dc.js"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "express": "^5.2.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode-generator": "^1.4.4"
  }
}
